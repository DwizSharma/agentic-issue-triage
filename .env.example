# Copy to .env and replace every example value before deployment.
APP_ENV=production
TRIAGE_MODE=synthetic
GITHUB_REPOSITORY=your-org/your-repository
GITHUB_TOKEN=

# Create with: openssl rand -hex 32
TRIAGE_API_KEY=replace-with-a-long-random-secret
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=
GITHUB_WRITEBACK=false

# Create with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-password
QDRANT_API_KEY=replace-with-a-long-random-secret
EMBEDDING_BACKEND=hashing
MAX_ISSUES=400
MAX_COMMITS=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------------------
# LLM backend for repro-test generation
# ---------------------------------------------------------------------------
# Option A — no LLM (default): generates a hollow stub test, instant response
LLM_BACKEND=stub

# Option B — Ollama (recommended for local use):
# 1. Install Ollama: https://ollama.com
# 2. Pull a model:   ollama pull llama3
#                    ollama pull qwen2.5-coder:7b   (better for code)
# 3. Set below and restart the server
# LLM_BACKEND=openai_compat
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3

# Option C — any OpenAI-compatible server (vLLM, LM Studio, OpenAI API):
# LLM_BACKEND=openai_compat
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
